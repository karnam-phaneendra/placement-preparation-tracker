# =============================================
# Placement Preparation Tracker — .gitignore
# =============================================

# Java compiled class files and build output
bin/
*.class
*.jar
*.war
*.ear

# Eclipse IDE project files
.classpath
.project
.settings/
*.launch

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr

# NetBeans
nbproject/
nbbuild/
dist/
nbdist/
.nb-gradle/

# VS Code
.vscode/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# JDBC / External dependency JARs
# (MySQL Connector/J is at D:/24a85a6102/ — not in project dir)
lib/*.jar

# Log files
*.log
logs/

# Temp files
*.tmp
*.bak
*.swp
*~

# Windows shortcut files
*.lnk
